# Real OpenAI key — this app runs a genuine LangChain agent, not a scripted one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Where the Aegis control tower is running.
AEGIS_API_URL=http://127.0.0.1:8000
# API key from Aegis's Applications page (POST /applications) for an app
# registered against process=procurement_review. Required — /guard/evaluate
# rejects requests with no key.
AEGIS_API_KEY=
AEGIS_SOURCE_APP=procurement_copilot
