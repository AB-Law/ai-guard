OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Storage backend (see README "Storage backends"). Unset = today's default:
# SQLite audit log, in-memory CaseStore + checkpointer (fast, single-process).
# "sqlite"            -> fully persisted, still zero external services.
# postgresql://...     -> fully persisted, safe for multiple workers/replicas.
# docker compose sets this automatically for the `api` service.
DATABASE_URL=

# Dashboard login: the shared password POST /auth/login checks, and the
# secret dashboard session tokens are signed with (any long random string —
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
DASHBOARD_PASSWORD=
JWT_SECRET=

# OpenTelemetry (optional — off by default; local/offline needs no collector).
# AEGIS_OTEL_ENABLED=1
# OTEL_SERVICE_NAME=aegis
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Model cost estimates (optional). USD per 1M tokens. Without this, token
# totals may still appear when providers report usage, but estimated cost
# stays unavailable (never fabricated as $0).
# AEGIS_MODEL_PRICING_JSON={"gpt-4o":{"input_per_1m":2.5,"output_per_1m":10.0},"default":{"input_per_1m":2.5,"output_per_1m":10.0}}
